APP_ENV=development
APP_DEBUG=true
AUTH_MODE=development
SESSION_COOKIE_NAME=anki_session
CSRF_COOKIE_NAME=anki_csrf
SESSION_LIFETIME_DAYS=30
SESSION_COOKIE_SECURE=false
DATABASE_URL=postgresql+psycopg://anki:anki@localhost:5433/anki_card_app
DEVELOPMENT_USER_ID=00000000-0000-0000-0000-000000000001
DEVELOPMENT_USER_EMAIL=developer@localhost
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_RETRIES=0
MAX_UPLOAD_BYTES=10000000
MAX_ARCHIVE_FILES=250
MAX_ARCHIVE_UNCOMPRESSED_BYTES=50000000
